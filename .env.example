# ---------- Site ----------
# Local: http://localhost:3000  | Production: https://your-domain.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, server only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Text AI (server only) ----------
# Required for every text tool. Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override
AI_MODEL=claude-sonnet-5-5

# ---------- Image AI (server only) ----------
# Required only for the "AI Image" tool. Without it the tool shows a clear
# "not configured" message and no coins are charged.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# ---------- Stripe (server only) ----------
# Without these, checkout shows a clear "payments not configured" message.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Plan prices, coin costs and coin packages are edited in the Admin panel (stored in the database).

# --- Evolution: social connections (optional; without them manual results still work) ---
# base64 of 32 random bytes:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# TikTok for Developers app (needs platform approval for video.list)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram app (Instagram Login, professional accounts; needs Meta app review)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
